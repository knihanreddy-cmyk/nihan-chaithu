# Copy to .env.local and fill in. Restart `npm run dev` after changing.

# --- Admin login (/admin) ---
# Email and password you type on /admin/login.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
# A long random string used to sign the login cookie, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# --- MongoDB (page content + photo library + enquiries) ---
# MongoDB Atlas: Database > Connect > Drivers. Allow your host's IP in Network Access.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=portfolio

# --- ImageKit (photo storage) ---
# ImageKit dashboard > Developer options > API keys.
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# Folder in your ImageKit media library for uploads.
IMAGEKIT_FOLDER=/portfolio
